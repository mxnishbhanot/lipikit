{
  "name": "lipikit",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform (Windows + Linux) desktop AI writing assistant",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lipikit/desktop dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @lipikit/desktop build",
    "dev:landing": "pnpm --filter @lipikit/landing dev",
    "build:landing": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @lipikit/landing build",
    "dist:win": "pnpm build && pnpm --filter @lipikit/desktop dist:win",
    "dist:linux": "pnpm build && pnpm --filter @lipikit/desktop dist:linux",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "pnpm --filter @lipikit/database test",
    "test:e2e": "playwright test",
    "dist": "pnpm build && pnpm --filter @lipikit/desktop dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.8.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "author": "mxnishbhanot",
  "license": "MIT",
  "homepage": "https://github.com/mxnishbhanot/lipikit",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxnishbhanot/lipikit.git"
  }
}
