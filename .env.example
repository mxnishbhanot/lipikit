# Copy to .env for local development. Never commit .env.
# Provider API keys are NOT read from here: they are entered in the app and
# stored encrypted by the OS keyring (DPAPI / libsecret). This file holds only
# non-secret runtime configuration.

# development | production | test
NODE_ENV=development

# debug | info | warn | error
AI_ANYWHERE_LOG_LEVEL=debug

# Renderer dev server; must match electron-vite's port.
VITE_DEV_SERVER_URL=http://localhost:5173

# SQLite file name, created inside Electron's userData directory.
AI_ANYWHERE_DB_FILE=ai-anywhere.db

# Local model runtime (optional, used by the Ollama provider later).
OLLAMA_BASE_URL=http://127.0.0.1:11434
