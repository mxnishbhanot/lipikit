# Copy to .env for local development. Never commit .env.
# Provider API keys are NOT read from here: they are entered in the app and
# stored encrypted by the OS keyring (DPAPI / libsecret). This file holds only
# non-secret runtime configuration.

# development | production | test
NODE_ENV=development

# debug | info | warn | error
LIPIKIT_LOG_LEVEL=debug

# Renderer dev server; must match electron-vite's port.
VITE_DEV_SERVER_URL=http://localhost:5173

# SQLite file name, created inside Electron's userData directory.
LIPIKIT_DB_FILE=lipikit.db

# Local model runtime. Used as the Ollama provider's endpoint; "/v1" (its
# OpenAI-compatible path) is appended by the app.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Wait (ms) applied around synthetic Ctrl+C / Ctrl+V. Capture is a race against
# the target app: a local editor answers in ~40ms, a loaded Electron app or an
# RDP session can need 250ms+. Raise this if selections come back empty.
LIPIKIT_INPUT_SETTLE_MS=120
