{
  "name": "@ai-anywhere/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "AI writing assistant available anywhere via a global hotkey",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "electron-builder --win --config electron-builder.yml",
    "dist:linux": "electron-builder --linux --config electron-builder.yml",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@tanstack/react-query": "^5.59.16",
    "better-sqlite3": "^11.5.0",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@ai-anywhere/context-engine": "workspace:*",
    "@ai-anywhere/database": "workspace:*",
    "@ai-anywhere/platform": "workspace:*",
    "@ai-anywhere/prompts": "workspace:*",
    "@ai-anywhere/providers": "workspace:*",
    "@ai-anywhere/shared": "workspace:*",
    "@ai-anywhere/ui": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "author": "mxnish-bhanot",
  "license": "MIT",
  "homepage": "https://github.com/mxnish-bhanot/ai-anywhere"
}
